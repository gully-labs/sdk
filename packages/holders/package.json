{
  "name": "@gullylabs/holders",
  "version": "0.1.0",
  "description": "Typed client for the Gully Labs Holder Map API, and a React component that frames the map: who holds a token and how the biggest wallets are connected.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./react": { "types": "./dist/react.d.ts", "default": "./dist/react.js" }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "peerDependencies": { "react": ">=18" },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "keywords": ["holder map", "token holders", "bubblemaps", "launchpad", "wallet clusters", "react", "embed", "defi"],
  "homepage": "https://docs.gullylabs.xyz/holder-map-integrate",
  "repository": { "type": "git", "url": "git+https://github.com/gully-labs/sdk.git", "directory": "packages/holders" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/holders.test.mjs"
  }
}
