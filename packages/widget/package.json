{
  "name": "@gullylabs/widget",
  "version": "0.1.0",
  "description": "The Gully Labs stock token tracker widget: a live ticker, badge or table on any page, with a React component.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./react": { "types": "./dist/react.d.ts", "default": "./dist/react.js" },
    "./widget.js": "./widget.js"
  },
  "files": ["dist", "widget.js", "README.md", "LICENSE"],
  "sideEffects": ["./widget.js"],
  "peerDependencies": { "react": ">=18" },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "keywords": ["widget", "tokenized stocks", "stock tokens", "react", "embed", "chainlink"],
  "homepage": "https://docs.gullylabs.xyz/widget",
  "repository": { "type": "git", "url": "git+https://github.com/gully-labs/sdk.git", "directory": "packages/widget" },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  }
}
